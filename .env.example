# Export these before `npm run server`. They are read by the Node server in
# server/ only. Never prefix them with VITE_: anything Vite exposes ends up in
# the browser bundle.

# Base URL of a running CUGA server, for example http://127.0.0.1:8005.
# Leave empty to run the CUGA tab as a guided demo. Model keys belong in CUGA's
# own .env, not here.
CUGA_BASE_URL=

# Base URL of a Hive dashboard. Leave empty to run the Hive tab as a guided
# preview with sample data.
HIVE_BASE_URL=

# Hive dashboard shared token (HIVE_DASHBOARD_TOKEN on the Hive side). Needed
# only when the dashboard requires authentication. Use a read-only credential.
HIVE_DASHBOARD_TOKEN=

# Address and port for this server. It binds to loopback by default.
HOST=127.0.0.1
PORT=8787

# Requests per client per minute across all /api routes.
RATE_LIMIT_PER_MINUTE=20

# Shared deployments: when set, every /api request must carry this value in an
# X-Access-Token header. Have an authenticating reverse proxy inject it.
BFF_ACCESS_TOKEN=

# Set to 1 only when exactly one trusted reverse proxy appends the client
# address to X-Forwarded-For, so the rate limit keys on the real client address
# (the last entry; earlier entries are client-controlled).
TRUST_PROXY=
